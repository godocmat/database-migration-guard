{
  "schema_version": 1,
  "split": "development",
  "migration_root": "migrations",
  "postgres": {
    "17": "17.12",
    "18": "18.7"
  },
  "sqlx_version": "0.8.6",
  "policy": {
    "coverage_required": true,
    "trusted_git_base_required": true,
    "applied_history_required": false,
    "deny_at_or_above": "HIGH",
    "deny_git_status": ["modified", "missing"],
    "check_precedence": [2, 3, 1, 0]
  },
  "applied_status": "unknown",
  "profiles": {
    "plain": {
      "adapter": "plain",
      "runner": "psql",
      "format": "simple",
      "filename_pattern": "^([0-9]+)_[a-z][a-z0-9_]*\\.sql$",
      "version_order": "positive-integer",
      "baseline": "simple",
      "mode": "psql-file-transaction"
    },
    "sqlx-simple": {
      "adapter": "sqlx",
      "runner": "sqlx",
      "format": "simple",
      "baseline": "simple",
      "mode": "sqlx-file-transaction"
    },
    "sqlx-reversible": {
      "adapter": "sqlx",
      "runner": "sqlx",
      "format": "reversible",
      "baseline": "reversible",
      "mode": "sqlx-file-transaction"
    }
  },
  "modes": {
    "psql-file-transaction": {
      "runner": "psql",
      "description": "One psql -X -v ON_ERROR_STOP=1 --single-transaction --file invocation per migration."
    },
    "psql-autocommit": {
      "runner": "psql",
      "description": "One psql -X -v ON_ERROR_STOP=1 --file invocation per migration, with autocommit."
    },
    "psql-explicit": {
      "runner": "psql",
      "description": "Use the unwrapped psql --file invocation and take transaction boundaries from BEGIN and COMMIT in the SQL."
    },
    "sqlx-file-transaction": {
      "runner": "sqlx",
      "description": "sqlx migrate run wraps the migration and its essential history write."
    },
    "sqlx-opt-out-single": {
      "runner": "sqlx",
      "description": "The byte-zero directive opts out of SQLx's wrapper. The single statement executes in one simple Query."
    },
    "sqlx-opt-out-batch": {
      "runner": "sqlx",
      "description": "The byte-zero directive opts out of SQLx's wrapper. Multiple statements execute in one simple Query with an implicit PostgreSQL block."
    }
  },
  "baselines": {
    "simple": [
      ["migrations/001_base.sql", "inputs/base.sql"]
    ],
    "reversible": [
      ["migrations/001_base.up.sql", "inputs/base.sql"],
      ["migrations/001_base.down.sql", "inputs/base-down.sql"]
    ]
  },
  "seeds_after_version": 1,
  "seeds": {
    "schema-only": [],
    "clean": ["inputs/seed-clean.sql"],
    "null-email": ["inputs/seed-clean.sql", "inputs/seed-null-email.sql"],
    "orphan-event": ["inputs/seed-clean.sql", "inputs/seed-orphan-event.sql"]
  },
