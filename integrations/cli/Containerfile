FROM docker.io/library/buildpack-deps:noble-scm@sha256:3499ba66ea3258e86ebedc69188f58882e2738357dea0e1583da9838d61e15bd

ARG DMG_BINARY_SHA256
ARG DMG_SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$DMG_SOURCE_COMMIT

COPY --chmod=0555 dmg /usr/local/bin/dmg
RUN printf '%s\n' "$DMG_BINARY_SHA256" | grep -Ex '[0-9a-f]{64}' >/dev/null \
    && printf '%s\n' "$DMG_SOURCE_COMMIT" | grep -Ex '[0-9a-f]{40}|[0-9a-f]{64}' >/dev/null \
    && printf '%s  /usr/local/bin/dmg\n' "$DMG_BINARY_SHA256" | sha256sum --check --strict - \
    && git --version \
    && /usr/local/bin/dmg --version

ENV HOME=/tmp
WORKDIR /workspace
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/dmg"]
CMD ["--help"]
